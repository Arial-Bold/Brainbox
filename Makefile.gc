#---------------------------------------------------------------------------------
# Clear the implicit built in rules
#---------------------------------------------------------------------------------
.SUFFIXES:
#---------------------------------------------------------------------------------
ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif

#include $(DEVKITPPC)/gamecube_rules
include $(DEVKITPRO)/libogc2/gamecube_rules

# get-deps.sh downloads two things into third_party: Flite (the speech
# engine, from Carnegie Mellon University; only the files below are built:
# the engine, US English, its dictionary and the cmu_us_rms voice) and
# mbedTLS (the secure connection to the AI services).
FLITE		:=	third_party/flite
MBEDTLS		:=	third_party/mbedtls
ifneq (build_GC,$(notdir $(CURDIR)))
ifneq ($(MAKECMDGOALS),clean)
ifeq ($(wildcard $(FLITE)/src/synth/flite.c),)
$(error "Flite not found in $(FLITE). Run sh get-deps.sh first (see README.md)")
endif
ifeq ($(wildcard $(MBEDTLS)/library/ssl_tls.c),)
$(error "mbedTLS not found in $(MBEDTLS). Run sh get-deps.sh first (see README.md)")
endif
endif
endif
FLITE_FILES	:=	third_party/flite/src/audio/au_none.c \
			third_party/flite/src/audio/au_streaming.c \
			third_party/flite/src/audio/audio.c \
			third_party/flite/src/utils/cst_alloc.c \
